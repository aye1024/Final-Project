<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18.0" styleClass="help-root" stylesheets="@yahtzee.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.HowToPlayController">
    <children>
        <VBox alignment="CENTER" maxHeight="760.0" maxWidth="620.0" spacing="16.0" styleClass="help-panel">
            <children>
                <Label styleClass="subtitle-label" text="How to Play" />
                <ImageView fitHeight="620.0" fitWidth="560.0" pickOnBounds="true" preserveRatio="true" styleClass="help-image">
                    <Image url="@img/howtoplay.jpg" />
                </ImageView>
                <Button fx:id="toMainMenu" onAction="#toMainMenu" styleClass="secondary-button" text="Main Menu" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>
