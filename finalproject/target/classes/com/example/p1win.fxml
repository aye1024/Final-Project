<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="24.0" styleClass="result-root" stylesheets="@yahtzee.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.P1WinController">
    <children>
        <VBox alignment="CENTER" maxWidth="560.0" spacing="24.0" styleClass="result-panel">
            <children>
                <Label styleClass="title-label" text="Player 1 Wins!" />
                <ImageView fitHeight="280.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="true" styleClass="result-image">
                    <Image url="@img/laughing_baby.jpg" />
                </ImageView>
                <Button fx:id="tertiaryButton" onAction="#toMainMenu" text="Main Menu" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>
