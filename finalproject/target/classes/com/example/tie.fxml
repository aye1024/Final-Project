<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="24.0" styleClass="result-root" stylesheets="@yahtzee.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.TieController">
    <children>
        <VBox alignment="CENTER" maxWidth="640.0" minWidth="520.0" spacing="26.0" styleClass="result-panel">
            <children>
                <Label alignment="CENTER" maxWidth="600.0" styleClass="title-label" text="Tie Game!" />
                <Button fx:id="toMainMenu" onAction="#toMainMenu" text="Main Menu" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>
